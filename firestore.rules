rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    match /users/{uid} {
      allow get: if signedIn();
      allow list: if false;
      allow create, update, delete: if owner(uid);
      match /following/{targetId} {
        allow read, write: if owner(uid);
      }
      match /likes/{trackId} {
        allow read, write: if owner(uid);
      }
      match /playlists/{playlistId} {
        allow get, list: if owner(uid) || (signedIn() && resource.data.isPublic == true);
        allow create, update, delete: if owner(uid);
        match /tracks/{trackId} {
          allow read: if owner(uid) || (signedIn() &&
            get(/databases/$(database)/documents/users/$(uid)/playlists/$(playlistId)).data.isPublic == true);
          allow write: if owner(uid);
        }
      }
    }
  }
}
